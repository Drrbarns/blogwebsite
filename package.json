{
  "name": "blogwebsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --no-server-fast-refresh",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/seed.ts",
    "create-admin": "cross-env NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/create-admin.ts",
    "update-brand": "cross-env NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/update-brand.ts",
    "rewrite-content": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/rewrite-content.ts",
    "insert-burnout-post": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/insert-burnout-post.ts",
    "generate-og": "tsx scripts/generate-og.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/plugin-nested-docs": "^3.84.1",
    "@payloadcms/plugin-redirects": "^3.84.1",
    "@payloadcms/plugin-search": "^3.84.1",
    "@payloadcms/plugin-seo": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "graphql": "^16.13.2",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "payload": "^3.84.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pg": "^8.20.0",
    "sass": "^1.77.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
